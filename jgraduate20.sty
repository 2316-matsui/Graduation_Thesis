% ページレイアウト
\def\ps@jgraduate{%
   \def\@oddhead{\underline{\hbox to \textwidth{~~\bf\rightmark\hfil%
        \thepage~~}}}%
   \def\@evenhead{
      \ifnum \@doubleside=1
         \underline{\hbox to \textwidth{~~\bf\thepage\hfil%
              \leftmark~~}}
      \else
         \@oddhead%
      \fi
  }%
   \def\@oddfoot{$\overline{\hbox to \textwidth{\hfil%
         \@university\ \@department\ \@major~~}}$}%
   \def\@evenfoot{
      \ifnum \@doubleside=1
          $\overline{\hbox to \textwidth{~~%
               \@university\ \@department\ \@major \hfil}}$%
      \else
         \@oddfoot%
      \fi
   }
   \let\@mkboth\markboth
   \def\chaptermark##1{\markboth{%
      \ifnum \c@secnumdepth >\m@ne
         \if@mainmatter
            \@chapapp\thechapter\@chappos\hskip1zw
         \fi
      \fi
     ##1}{}}%
  \def\sectionmark##1{\markright{%
     \ifnum \c@secnumdepth >\z@ \thesection\hskip1zw\fi
     ##1}}%
}

% 表紙
\def\mtitle{
 \begin{titlepage}%
  \null%
  \vfil%
  \begin{center}%
   {\fontsize{36}{40pt}\selectfont 修 \ \ 士 \ \ 論 \ \ 文}\vskip 2em minus 1em%
   {\fontsize{24}{26pt}\selectfont \@date}\vskip 26em minus 1em%
   {\Large\@university} \vskip 1em minus 1em%
   {\Large\@department} \vskip 1em minus 1em%
   {\Large\@major} \vskip 2em minus 1em%
   {\Large\@authorid \ \ 
   \@author\par}
  \end{center}%
  \vfil%
 \end{titlepage}%
}
\def\m2title{
 \begin{titlepage}%
  \null%
  \vfil%
  \begin{center}%
   {\fontsize{36}{40pt}\selectfont 修 \ \ 士 \ \ 論 \ \ 文}\vskip 10em minus 1em%
   {\Large\@title\par}\vskip 2em minus 1em%
   {\Large\@etitle\par}\vskip 14em minus 1em%
  \end{center}%
  \vfil%
 \end{titlepage}%
}
\def\maketitle{
 \begin{titlepage}%
  \null%
  \vfil%
  \begin{center}%
   {\fontsize{20}{24pt}\selectfont \@year \ \ 卒業論文}\vskip 4em minus 1em%
   {\fontsize{24}{26pt}\selectfont \@title}\vskip 16em minus 1em%
   {\fontsize{20}{24pt}\selectfont \@university\@department\@major} \vskip 6em minus 1em%
   {\fontsize{20}{24pt}\selectfont 作成者 \ \ \@authorid \ \ \@author\par}\vskip 1em minus 1em%
   {\fontsize{20}{24pt}\selectfont \@date\par} \vskip 4em minus 1em%
   {\fontsize{20}{24pt}\selectfont 指導教員 \ \ \@teacherpos \ \ \@teacher\par}\vskip 4em minus 1em%
   \ifnum \@coauthornum=3
   {\fontsize{20}{24pt}\selectfont
   \begin{tabular}{lll}
    共同研究者 \ \ & \@cfauthid \ \ & \@cfauth\\
                   & \@csauthid & \@csauth\\
                   & \@ctauthid & \@ctauth\\
   \end{tabular}
   }
   \else
      \ifnum \@coauthornum=2
      {\fontsize{20}{24pt}\selectfont
       \begin{tabular}{lll}
      共同研究者 \ \ & \@cfauthid \ \ & \@cfauth\\
                 & \@csauthid & \@csauth\\
      \end{tabular}
      \vskip 2em
      }
      \else
      \ifnum \@coauthornum=1
      {\fontsize{20}{24pt}\selectfont
       \begin{tabular}{lll}
      共同研究者 \ \ & \@cfauthid \ \ & \@cfauth\\
      \end{tabular}
      }
      \vskip 4em
      \else
      \vskip 6em
      \fi
   \fi
\fi   
  \end{center}%
  \vfil%
 \end{titlepage}%
}
\def\cleardoublepageskip{
  \ifnum \@doubleside=1
     \cleardoublepage
  \else
     \clearpage
  \fi
}
