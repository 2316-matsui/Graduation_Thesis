% 目次
\def\tableofcontents{%
 \pagenumbering{roman}
 \if@twocolumn\@restonecoltrue\onecolumn
 \else\@restonecolfalse\fi
 \chaptersec*{\contentsname%
   \@mkboth{\contentsname}{\contentsname}}%
 \@starttoc{toc}%
 \if@restonecol\twocolumn\fi
% \pagenumbering{arabic}
}
\def\listoffigures{%
  \if@twocolumn\@restonecoltrue\onecolumn
  \else\@restonecolfalse\fi
  \chaptersec*{\listfigurename
  \@mkboth{\listfigurename}{\listfigurename}}%
  \@starttoc{lof}%
  \if@restonecol\twocolumn\fi
}
\def\listoftables{%
  \if@twocolumn\@restonecoltrue\onecolumn
  \else\@restonecolfalse\fi
  \chaptersec*{\listtablename
  \@mkboth{\listtablename}{\listtablename}}%
  \@starttoc{lot}%
  \if@restonecol\twocolumn\fi
}
% 章関係
%   天に ページ番号と章の内容(番号無し)+ライン
%   地に 所属 + ライン
\def\chaptersec{%
% \if@openright\clearpage\else\clearpage\fi
%  \thispagestyle{plain}%
 \if@openright\clearpage\else\clearpage\fi
 \global\@topnum\z@
 \@afterindenttrue
 \secdef\@chaptersec\@schapter
}
%
% 章関係
%   章の最初のページは、天と地にラインをひかない。
%   ページ番号は、地におく
\def\chapter{%
  \if@openright{
      \ifnum \@doubleside=1
          \cleardoublepage
      \else
          \clearpage      
      \fi
  }
  \else\clearpage\fi
%  \if@openright\clearpage\else\clearpage\fi
  \thispagestyle{plain}%
  \global\@topnum\z@
  \@afterindenttrue
  \secdef\@chapter\@schapter}
\def\@makechapterhead#1{%
  \vspace*{50\p@}%
  {%
   \parindent \z@ \raggedright
   \reset@font\huge\bfseries
   \ifnum \c@secnumdepth >\m@ne
    \@chapapp\thechapter\@chappos
    \par\nobreak
    \vskip 20\p@
   \fi
   \interlinepenalty\@M
   #1\par\nobreak
   \vskip 40\p@
  }%
}
\def\@makeschapterhead#1{%
 \vspace*{50\p@}%
 {%
  \parindent \z@ \raggedright
  \reset@font\huge\bfseries
  \interlinepenalty\@M
  #1\par\nobreak
  \vskip 40\p@
 }%
}

% 索引
\renewenvironment{theindex}
  {\newpage\if@twocolumn\@restonecolfalse\else\@restonecoltrue\fi%
   \columnseprule\z@ \columnsep 35\p@%
   \twocolumn[\chapter*{\indexname}]%
   \addcontentsline{toc}{chapter}{\indexname}
   \@mkboth{\indexname}{\indexname}%
   \parindent\z@%
   \parskip\z@ \@plus .3\p@\relax%
   \let\item\@idxitem%
  }
  {\if@restonecol\onecolumn\else\clearpage\fi}


% 謝辞
\def\acknowledgementname{\def\@cknowledgementname}
\let\acknowledgmentname\acknowledgementname
\acknowledgementname{謝辞}

\def\acknowledgement{%
 \typeout{\@cknowledgementname}%
% \chaptersec*{\@cknowledgementname}%
 \chapter*{\@cknowledgementname}%
 \@mkboth{\@cknowledgementname}{\@cknowledgementname}%
 \addcontentsline{toc}{chapter}{\@cknowledgementname}%
}
\let\acknowledgment\acknowledgement

% 参考文献
\def\bibname{参考文献}
\renewenvironment{thebibliography}[1]
%{\chaptersec*{\bibname}%
{\chapter*{\bibname}%
   \@mkboth{\bibname}{\bibname}%
   \addcontentsline{toc}{chapter}{\bibname}%
   \list{\@biblabel{\@arabic\c@enumiv}}%
        {\settowidth\labelwidth{\@biblabel{#1}}%
         \leftmargin\labelwidth
         \advance\leftmargin\labelsep
         \@openbib@code
         \usecounter{enumiv}%
         \let\p@enumiv\@empty
         \renewcommand\theenumiv{\@arabic\c@enumiv}}%
   \sloppy
   \clubpenalty4000
   \@clubpenalty\clubpenalty
   \widowpenalty4000%
   \sfcode`\.\@m}
  {\def\@noitemerr
    {\@latex@warning{Empty `thebibliography' environment}}%
   \endlist}

